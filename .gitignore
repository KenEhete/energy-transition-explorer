# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- Virtual environment ---
.venv/
venv/

# --- Data ---
# Raw and processed data are NOT committed. They are rebuilt by
# running the download and cleaning scripts, and data/manifest.json
# records exactly which version of the data was used.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
